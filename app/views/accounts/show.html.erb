<div class="w-full max-w-5xl mx-auto pb-12">
  <%= render "shared/header" %>

  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <%= link_to t("statement.back"), root_path, class: "text-sm font-medium text-emerald-300 hover:text-emerald-200 transition" %>
    <%= link_to t("statement.download_csv"), export_account_path(@account),
        class: "text-xs font-semibold bg-white/10 hover:bg-white/20 border border-white/15 text-white px-4 py-2 rounded-xl transition" %>
  </div>

  <div class="<%= glass_card('p-6 mb-8 flex flex-wrap items-center justify-between gap-4') %>">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span dir="ltr" class="font-mono text-xs font-bold bg-white/10 text-emerald-300 px-2.5 py-1 rounded-lg border border-white/10"><%= @account.account_number %></span>
        <%= account_type_badge(@account) %>
      </div>
      <h1 class="text-2xl font-bold text-white"><%= @account.name %></h1>
      <p class="text-xs text-slate-400 mt-1">
        <%= t("statement.normal_side") %>: <%= t("sides.#{@account.debit_normal? ? 'debit' : 'credit'}") %> ·
        <%= t("statement.currency") %>: <%= @account.currency %>
      </p>
    </div>
    <div class="text-end">
      <div class="text-xs text-slate-400 mb-1"><%= t("statement.current_balance") %></div>
      <div class="text-3xl font-bold text-white"><%= money_display(@account.balance) %></div>
    </div>
  </div>

  <div class="<%= glass_card('overflow-hidden') %>">
    <div class="px-6 py-4 border-b border-white/10">
      <h2 class="font-bold text-white"><%= t("statement.title") %></h2>
    </div>
    <% if @entries.empty? %>
      <div class="p-10 text-center text-slate-400 text-sm"><%= t("statement.empty") %></div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-start text-sm">
          <thead class="bg-white/5 text-slate-400 border-b border-white/10 text-xs">
            <tr>
              <th class="px-6 py-3.5 text-start"><%= t("statement.timestamp") %></th>
              <th class="px-6 py-3.5 text-start"><%= t("statement.reference") %></th>
              <th class="px-6 py-3.5 text-start"><%= t("statement.description") %></th>
              <th class="px-6 py-3.5 text-start"><%= t("statement.side") %></th>
              <th class="px-6 py-3.5 text-end"><%= t("statement.amount") %></th>
              <th class="px-6 py-3.5 text-end"><%= t("statement.balance_after") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            <% @entries.each do |entry| %>
              <tr class="hover:bg-white/5 transition">
                <td class="px-6 py-3.5 text-xs font-mono text-slate-400 whitespace-nowrap" dir="ltr"><%= entry.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
                <td class="px-6 py-3.5 font-mono text-xs font-semibold text-emerald-300" dir="ltr"><%= entry.ledger_transaction.reference %></td>
                <td class="px-6 py-3.5 text-slate-200"><%= entry.ledger_transaction.description %></td>
                <td class="px-6 py-3.5"><%= entry_side_badge(entry.entry_type) %></td>
                <td class="px-6 py-3.5 text-end font-semibold text-white"><%= money_display(entry.amount) %></td>
                <td class="px-6 py-3.5 text-end font-bold text-indigo-300"><%= money_display(entry.balance_after) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>