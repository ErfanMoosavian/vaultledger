<header class="<%= glass_card('px-6 py-4 mb-8 flex flex-wrap items-center justify-between gap-4') %>">
  <%= link_to root_path, class: "flex items-center gap-3.5 group" do %>
    <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-400 via-teal-500 to-indigo-600 p-[1px] shadow-lg shadow-emerald-500/20">
      <div class="w-full h-full rounded-[11px] bg-slate-950/90 flex items-center justify-center font-mono font-bold text-emerald-400 text-base">
        VL
      </div>
    </div>
    <div>
      <div class="flex items-center gap-2">
        <span dir="ltr" class="text-xl font-bold tracking-tight text-white"><%= t("app.name") %></span>
        <span class="text-[11px] font-semibold bg-emerald-400/15 text-emerald-300 border border-emerald-400/30 px-2.5 py-0.5 rounded-full">
          <%= t("app.badge") %>
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-0.5"><%= t("app.subtitle") %></p>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if @audit_report&.passed %>
      <div class="flex items-center gap-2 bg-emerald-500/10 border border-emerald-400/30 text-emerald-300 px-3.5 py-2 rounded-xl text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span><%= t("app.audit_passed") %></span>
      </div>
    <% elsif @audit_report %>
      <div class="flex items-center gap-2 bg-rose-500/15 border border-rose-400/40 text-rose-300 px-3.5 py-2 rounded-xl text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-rose-400 animate-ping"></span>
        <span><%= t("app.audit_failed") %></span>
      </div>
    <% end %>

    <%= link_to t("app.json_audit"), api_v1_audit_path, target: "_blank",
        class: "text-xs font-medium bg-white/10 hover:bg-white/15 border border-white/15 text-slate-100 px-3.5 py-2 rounded-xl transition" %>

    <div class="inline-flex rounded-xl border border-white/15 bg-slate-950/60 p-1 text-xs font-semibold">
      <%= link_to "EN", switch_locale_path(:en),
          class: "px-3 py-1 rounded-lg transition #{I18n.locale == :en ? 'bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 shadow-sm' : 'text-slate-400 hover:text-white'}" %>
      <%= link_to "فارسی", switch_locale_path(:fa),
          class: "px-3 py-1 rounded-lg transition #{I18n.locale == :fa ? 'bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 shadow-sm' : 'text-slate-400 hover:text-white'}" %>
    </div>
  </div>
</header>

<% if notice %>
  <div class="mb-6 rounded-2xl bg-emerald-500/10 backdrop-blur-md border border-emerald-400/30 px-5 py-3.5 text-emerald-200 text-sm font-medium">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div class="mb-6 rounded-2xl bg-rose-500/10 backdrop-blur-md border border-rose-400/30 px-5 py-3.5 text-rose-200 text-sm font-medium">
    <%= alert %>
  </div>
<% end %>