<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <head>
    <title>VaultLedger · Double-Entry Financial Core</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { font-family: "Inter", system-ui, sans-serif; }
      html[dir="rtl"] body { font-family: "Vazirmatn", system-ui, sans-serif; }
      .font-mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen antialiased relative overflow-x-hidden selection:bg-emerald-400/30 selection:text-emerald-200">
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -left-32 w-[34rem] h-[34rem] rounded-full bg-emerald-500/15 blur-3xl"></div>
      <div class="absolute top-1/4 -right-32 w-[32rem] h-[32rem] rounded-full bg-indigo-500/20 blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/3 w-[30rem] h-[30rem] rounded-full bg-cyan-500/10 blur-3xl"></div>
    </div>

    <main class="relative z-10 px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>
  </body>
</html>